# Copie este archivo como .env junto al docker-compose.yml y complete los valores.
# El archivo .env NO se versiona (ver .gitignore).

# Clave de la Riot Games API. Se obtiene en https://developer.riotgames.com
# La clave de desarrollo caduca cada 24 horas.
RIOT_API_KEY=RGAPI-000000-0000-0000-0000-000000000000

# Secreto de firma de los JWT que emite POST /api/v1/auth/token.
# Debe tener al menos 32 caracteres.
JWT_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio-32
