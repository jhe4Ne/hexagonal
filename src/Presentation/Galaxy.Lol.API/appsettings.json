{
  "ConnectionStrings": {
    "ChampionsDb": "Host=postgres_lol_hex;Port=5432;Database=bdchampions;Username=admin;Password=Password2026",
    "AnalyticsDb": "Server=sqlserver_lol_hex,1433;Database=bdanalitica;User Id=sa;Password=Password2026;TrustServerCertificate=True;Encrypt=False"
  },
  "Mongo": {
    "ConnectionString": "mongodb://admin:Password2026@mongo_lol_hex:27017/?authSource=admin",
    "Database": "lol_raw_cache",
    "CatalogCollection": "champion_catalog",
    "DetailCollection": "champion_detail"
  },
  "RiotApi": {
    "BaseUrlTemplate": "https://{0}.api.riotgames.com",
    "DefaultPlatform": "la1",
    "ApiKeyHeader": "X-Riot-Token",
    "TimeoutSeconds": 30,
    "RequestsPerSecond": 20,
    "MaxRetries": 3
  },
  "DataDragon": {
    "BaseUrl": "https://ddragon.leagueoflegends.com",
    "DefaultLocale": "es_MX",
    "TimeoutSeconds": 30
  },
  "Smtp": {
    "Host": "mailhog_lol_hex",
    "Port": 1025,
    "UseSsl": false,
    "From": "no-reply@galaxy-lol.local",
    "FromName": "Galaxy LoL Champions",
    "To": "equipo@galaxy-lol.local",
    "Enabled": true
  },
  "Jwt": {
    "Issuer": "galaxy-lol-hexagonal",
    "Audience": "galaxy-lol-clients",
    "ExpirationMinutes": 120
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://jaeger_lol_hex:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://seq_lol_hex:80" } }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "Galaxy.Lol.API" }
  },
  "AllowedHosts": "*"
}
